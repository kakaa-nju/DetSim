+        void* base = MAP_FAILED;
+        size_t mapped_size = 0, offset = 0, length = 0;
+        Mapping(void* p, size_t n, size_t off, size_t len) noexcept
+            : base(p), mapped_size(n), offset(off), length(len) {}
