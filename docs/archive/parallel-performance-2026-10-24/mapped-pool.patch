+    ImmutableBytes(const ImmutableBytes&) = delete;
+    ImmutableBytes& operator=(const ImmutableBytes&) = delete;
+    ImmutableBytes(ImmutableBytes&&) noexcept = default;
+    ImmutableBytes& operator=(ImmutableBytes&&) noexcept = default;
+    // Caller guarantees file contents remain immutable while any owner is held.
+    // The mapping retains the inode independently of the descriptor/path lifetime.
+    static ImmutableBytes map_file(int fd, size_t offset, size_t length) {
+        struct stat info{};
+        if (fstat(fd, &info)) throw std::system_error(errno,std::generic_category(),"inspect immutable mapping");
+        if (!S_ISREG(info.st_mode) || info.st_size <= 0 ||
+            uintmax_t(info.st_size) > std::numeric_limits<size_t>::max())
+            throw std::invalid_argument("immutable mapping needs a nonempty regular file");
+        const auto size = static_cast<size_t>(info.st_size);
+        if (!length || offset > size || length > size-offset)
+            throw std::invalid_argument("immutable mapping payload outside file");
+        void* base = mmap(nullptr,size,PROT_READ,MAP_SHARED,fd,0);
+        if (base == MAP_FAILED) throw std::system_error(errno,std::generic_category(),"map immutable bytes");
+        return ImmutableBytes(Mapping(base,size,offset,length));
+    }
+    bool is_mapped() const noexcept { return std::holds_alternative<Mapping>(storage_); }
+    const uint8_t* data() const noexcept {
