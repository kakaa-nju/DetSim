+        const auto& m = std::get<Mapping>(storage_);
+        return m.base == MAP_FAILED ? nullptr : static_cast<const uint8_t*>(m.base)+m.offset;
+    }
+    size_t size() const noexcept {
+        if (const auto* bytes = std::get_if<std::vector<uint8_t>>(&storage_)) return bytes->size();
+        const auto& m = std::get<Mapping>(storage_);return m.base == MAP_FAILED ? 0 : m.length;
+    }
+    bool empty() const noexcept { return size()==0; }
+    const_iterator begin() const noexcept { return data(); }
+    const_iterator end() const noexcept { return empty() ? data() : data()+size(); }
+    const uint8_t& operator[](size_t i) const noexcept { return data()[i]; }
+    friend bool operator==(const ImmutableBytes& a, std::span<const uint8_t> b) {
+        return a.size()==b.size() && std::equal(a.begin(),a.end(),b.begin());
+    }
+    friend bool operator==(const ImmutableBytes& a, const ImmutableBytes& b) {
+        return a.size()==b.size() && std::equal(a.begin(),a.end(),b.begin());
+    }
+};
+}
