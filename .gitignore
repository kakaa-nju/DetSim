# Ignore everything by default
*
*.*

# Source files
!*.c
!*.cpp
!*.h
!*.json
!*.md
!*.rst
!*.sh
!*.py
!LICENSE

# Build system
!Makefile
!CMakeLists.txt
!.clang-format

# Git
!.gitignore

# Source directories
!src/
!src/core/
!src/core/*
!src/subsys/
!src/subsys/*
!src/utils/
!src/utils/*
!src/ui/
!src/ui/*

# Perf benchmarks
!perf/
!perf/*

# Third party
!third_party/
!third_party/**

# Tests
!tests/
!tests/**

# Scripts
!scripts/
!scripts/*

# Docs
!docs/
!docs/**

# Build artifacts (ignored even with wildcards above)
tracer
*.o
*.d
*.so

# Runtime directories
build/
mappings/
memory/
filesystem/
tstate/
sstate/

# IDE
.cache/
.vscode/
.idea/

# Debug
core.*
*.log

# tools
!tools/
!tools/**

# examples
!examples/
!examples/**

# Storage tool binaries built by `make tools`
/tools/sstate_query
/tools/verify_sstate

# Parallel-search worker artifacts (created in the run directory)
.parallel-*/
